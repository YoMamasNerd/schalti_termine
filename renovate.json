{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "schedule": ["every weekend"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "assignees": ["YoMamasNerd"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["uv"],
      "groupName": "Python dependencies",
      "addLabels": ["python"]
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "CDN dependencies",
      "addLabels": ["cdn"]
    },
    {
      "matchDepNames": ["schalti_ui"],
      "groupName": "schalti_ui Design System",
      "addLabels": ["design-system"],
      "schedule": ["at any time"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "schalti_ui Git-Pin gegen den master-Branch tracken - oeffnet einen PR, sobald es dort einen neuen Commit gibt",
      "managerFilePatterns": ["/^requirements\\.txt$/"],
      "matchStrings": [
        "schalti_ui @ git\\+https://github\\.com/YoMamasNerd/schalti_ui\\.git@(?<currentDigest>[a-f0-9]+)"
      ],
      "depNameTemplate": "schalti_ui",
      "packageNameTemplate": "https://github.com/YoMamasNerd/schalti_ui.git",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "master"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^templates/.*\\.html$/", "/^.*/templates/.*\\.html$/"],
      "matchStrings": ["bootstrap@(?<currentValue>[\\d.]+)/dist/css", "bootstrap@(?<currentValue>[\\d.]+)/dist/js"],
      "depNameTemplate": "bootstrap",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^templates/.*\\.html$/", "/^.*/templates/.*\\.html$/"],
      "matchStrings": ["bootstrap-icons@(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "bootstrap-icons",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^templates/.*\\.html$/", "/^.*/templates/.*\\.html$/"],
      "matchStrings": ["htmx\\.org@(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "htmx.org",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
