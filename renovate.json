{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "schedule": [
    "every weekend"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "YoMamasNerd"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "uv"
      ],
      "groupName": "Python dependencies",
      "addLabels": [
        "python"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "CDN dependencies",
      "addLabels": [
        "cdn"
      ]
    },
    {
      "matchDepNames": [
        "schalti_ui",
        "schalti-ui"
      ],
      "matchPackageNames": [
        "https://github.com/YoMamasNerd/schalti_ui.git",
        "YoMamasNerd/schalti_ui",
        "schalti_ui",
        "schalti-ui"
      ],
      "groupName": "schalti_ui Design System",
      "addLabels": [
        "design-system"
      ],
      "schedule": [
        "at any time"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge minor, patch and digest updates once CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^templates/.*\\.html$/",
        "/^.*/templates/.*\\.html$/"
      ],
      "matchStrings": [
        "bootstrap@(?<currentValue>[\\d.]+)/dist/css",
        "bootstrap@(?<currentValue>[\\d.]+)/dist/js"
      ],
      "depNameTemplate": "bootstrap",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^templates/.*\\.html$/",
        "/^.*/templates/.*\\.html$/"
      ],
      "matchStrings": [
        "bootstrap-icons@(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "bootstrap-icons",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^templates/.*\\.html$/",
        "/^.*/templates/.*\\.html$/"
      ],
      "matchStrings": [
        "htmx\\.org@(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "htmx.org",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
