# Kopiere diese Datei nach ".env" und passe die Werte an.
# Die .env gehört NICHT ins Git-Repository.

# --- Pflicht im Betrieb ----------------------------------------------------

# Mit "python -c 'import secrets; print(secrets.token_urlsafe(50))'" erzeugen.
DJANGO_SECRET_KEY=bitte-aendern
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=termine.meine-fahrschule.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://termine.meine-fahrschule.de

# Wird für die Links in den E-Mails und für die Kalender-Abo-URL gebraucht.
SITE_BASE_URL=https://termine.meine-fahrschule.de
SITE_NAME=Fahrschule Muster – Beratungstermine

# --- Datenbank -------------------------------------------------------------
# Ohne POSTGRES_DB läuft die App auf SQLite unter data/db.sqlite3.

POSTGRES_DB=termine
POSTGRES_USER=termine
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- E-Mail ----------------------------------------------------------------
# Ohne EMAIL_HOST werden Mails nur auf der Konsole ausgegeben (Entwicklung).

EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=termine@meine-fahrschule.de
EMAIL_HOST_PASSWORD=bitte-aendern
EMAIL_USE_TLS=true
# Manche Anbieter verlangen statt Port 587 den Port 465. Dann EMAIL_PORT=465
# setzen, EMAIL_USE_TLS=false und die nächste Zeile auf true. Nie beide auf true.
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Fahrschule Muster <termine@meine-fahrschule.de>

# --- Buchungsregeln --------------------------------------------------------

# Wie lange ein Termin nach dem Absenden auf die E-Mail-Bestätigung wartet.
RESERVATION_MINUTES=30

# Vorgabe für neue Fahrlehrer, falls dort nichts eingetragen ist.
DEFAULT_HORIZON_WEEKS=4

# Wie viele Stunden vor dem Termin die Erinnerungsmail rausgeht.
REMINDER_HOURS_BEFORE=24

# Nach wie vielen Tagen die personenbezogenen Daten einer Buchung
# überschrieben werden (DSGVO-Löschkonzept).
DATA_RETENTION_DAYS=180

# --- Einbettung in die Fahrschulseite --------------------------------------
# Seiten, die die Terminauswahl unter /einbetten/ in einen Rahmen setzen
# dürfen. Leer = niemand. Beide Schreibweisen eintragen, mit und ohne www.
# Siehe docs/EINBETTEN.md.

EMBED_ORIGINS=https://meine-fahrschule.de,https://www.meine-fahrschule.de

# --- Fahrschulmanager (FSM) Integration ------------------------------------
# Optional: Synchronisiert Beratungstermine und Belegungszeiten (Sperrzeiten).
# FSM_SYNC_ENABLED=true
# FSM_EMAIL=ihre-email@beispiel.de
# FSM_PASSWORD=ihr-passwort

# --- Rechtliches -----------------------------------------------------------
# Erscheinen als Links im Seitenfuß. Leer lassen blendet sie aus.

IMPRESSUM_URL=https://meine-fahrschule.de/impressum
DATENSCHUTZ_URL=https://meine-fahrschule.de/datenschutz

# --- Sonstiges -------------------------------------------------------------

TIME_ZONE=Europe/Berlin
LOG_LEVEL=INFO

# --- HTTPS-Härtung (erst einschalten, wenn TLS dauerhaft steht) ------------

SECURE_SSL_REDIRECT=true
# 0 lässt HSTS aus. Sinnvoller Produktivwert: 31536000 (ein Jahr).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Cookies nur über HTTPS ausliefern. Beide sind ohnehin auf true vorbelegt und
# gehören nur dann auf false, wenn eine Installation bewusst ohne TLS läuft.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# --- Nur für docker-compose.tls.yml ----------------------------------------
# Wird gebraucht, wenn Caddy das Zertifikat selbst holen soll. Der Name muss
# im DNS auf diesen Server zeigen und mit SITE_BASE_URL übereinstimmen.

TLS_DOMAIN=termine.meine-fahrschule.de
